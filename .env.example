# ============ LeadSap .env (пример) ============
# Скопируйте этот файл в .env и заполните значения

# Порт сервера
PORT=3000

# Окружение (development | production)
NODE_ENV=development

# Секрет для JWT-токенов (сгенерируйте случайную строку)
JWT_SECRET=измените-меня-на-случайную-строку-минимум-32-символа

# ============ ВАЖНО: Anthropic Claude API ============
# 1. Зайдите на https://console.anthropic.com/settings/keys
# 2. Создайте новый ключ (Create Key)
# 3. Пополните баланс минимум на $5
# 4. Вставьте ключ ниже (никогда не отправляйте его в чат или git!)
ANTHROPIC_API_KEY=sk-ant-api03-вставьте-ваш-ключ-сюда

# Модель Claude (рекомендуется claude-sonnet-4-5)
CLAUDE_MODEL=claude-sonnet-4-5

# Путь к SQLite базе данных
DB_PATH=./leadsap.db
